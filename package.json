{
  "name": "saucedemo-playwright-cucumber",
  "version": "1.0.0",
  "private": true,
  "description": "Suite de automatizacion E2E para Sauce Demo con Playwright, Cucumber y Page Object Model",
  "author": "Jhosep Steeven Huamani Garcia",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "qa",
    "playwright",
    "cucumber",
    "typescript",
    "page-object-model",
    "test-automation"
  ],
  "scripts": {
    "test": "cucumber-js",
    "test:smoke": "cucumber-js --profile smoke",
    "test:regression": "cucumber-js --profile regression",
    "test:headed": "HEADLESS=false cucumber-js --profile smoke",
    "test:ci": "cucumber-js --profile ci",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"docs/**/*.md\" \"*.{json,md,cjs}\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"docs/**/*.md\" \"*.{json,md,cjs}\" \".github/**/*.yml\"",
    "report:open": "xdg-open reports/cucumber-report.html"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.9",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
